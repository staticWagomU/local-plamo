{
  "manifest_version": 3,
  "name": "ローカル翻訳",
  "description": "拡張に組み込んだ翻訳モデルでWebページを翻訳します。翻訳する文章は外部に送信されません。",
  "version": "1.0.0",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "contextMenus",
    "offscreen"
  ],
  "host_permissions": [
    "https://huggingface.co/*",
    "https://*.hf.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ローカル翻訳"
  },
  "commands": {
    "toggle-page": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "ページを翻訳 / 原文に戻す"
    },
    "toggle-hover": {
      "suggested_key": {
        "default": "Alt+H"
      },
      "description": "原文のホバー表示を切り替え"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  }
}
